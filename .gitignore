__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
*.log
.venv/
.DS_Store

# Challenge inputs: the organisers' released dataset, not redistributed here.
# dataset/MANIFEST.sha256 lists them with checksums so they can be verified.
dataset/*
!dataset/MANIFEST.sha256

# Working artefacts, rewritten by every run. Publish a validated one as a release
# asset instead; the stable ones live in models/.
runs/

# Written into the repo root by a run, not source.
calibration.json
logs/
# ...but keep the directory itself: Slurm opens the jobscript's -o and -e files
# before the body runs and will not create it, so a fresh checkout must already
# have it or the first submission dies with no log to say why.
!logs/.gitkeep
projection_scores.json

# Local scratch: put one-off benchmarks and probes in scratch/ so they cannot be
# committed by accident. The two named files were session benchmarks; `trimesh` is a
# stray download, not the package.
scratch/
bench_raster.py
surrogate_check.py
/trimesh

# A run's own console output and process ids, written into the repository root by
# nohup and by the pipeline. They are records of one machine's run, not source.
*.out
*.pid

uv.lock

# Local run tracking, not part of the method.
RUNS.md
